  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "VITE v"
          },
          "endsPattern": {
            "regexp": "Local:"
          }
        }
      }
    },
    {
      "type": "npm",
      "script": "build",
      "problemMatcher": "$tsc"
    }
  ]
}
